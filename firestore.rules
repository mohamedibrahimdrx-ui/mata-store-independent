rules_version = '2';
// OPTIONAL hardening. MATA's browser code never talks to Firestore: every read and write goes through the
// /api functions using the Firebase Admin SDK, which bypasses these rules. So the safest rules are "deny all".
// Compare with your current rules in Firebase Console > Firestore > Rules before publishing anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
