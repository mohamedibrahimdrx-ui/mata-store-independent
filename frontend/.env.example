# Copy to frontend/.env.local for local development. On Vercel, set the same names in
# Project Settings > Environment Variables (Production AND Preview), then REDEPLOY:
# Vite bakes VITE_* values in at build time, so changing them requires a new build.
#
# These are PUBLIC web-app identifiers (Firebase Console > Project settings > General > Your apps > Web app).
# They are not secrets, but they must be present or Firebase Auth fails with auth/invalid-api-key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
