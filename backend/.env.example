# Copy to .env and fill in. NEVER commit .env or paste these values anywhere public.
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated Firebase UIDs allowed to use the admin panel / admin API
ADMIN_UIDS=
# Cloudinary (images + optional video uploads). The secret stays on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: max product video upload in MB (default 50, hard cap 100). Keep the admin form limit in sync.
MAX_VIDEO_UPLOAD_MB=50
# Firestore credentials: the backend uses Application Default Credentials, e.g.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json   (file stays outside Git)
