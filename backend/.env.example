# Backend / Vercel Function environment. Copy to backend/.env for LOCAL development only.
# On Vercel, add these in Project Settings > Environment Variables (never commit real values).
# All of these are SERVER-ONLY: do not prefix them with VITE_.

# --- Local only -------------------------------------------------------------
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# --- Admin access -----------------------------------------------------------
# Comma-separated Firebase Auth UIDs allowed to use the admin panel / admin API.
ADMIN_UIDS=

# --- Firebase Admin (Firestore + verifying ID tokens) -----------------------
# Option A (recommended on Vercel): the whole service-account JSON on one line (raw or base64-encoded).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual values (use \n for line breaks inside the private key).
# FIREBASE_PROJECT_ID=mata-store-eg
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Option C (local development only): path to a key file kept OUTSIDE the repository.
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Cloudinary (images + product videos). The secret stays on the server. --
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: max product video upload in MB (default 50, hard cap 100).
MAX_VIDEO_UPLOAD_MB=50
